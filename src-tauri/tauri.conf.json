{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thorn Intelligence",
  "version": "0.1.0",
  "identifier": "com.thornintelligence.storage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thorn Intelligence",
        "width": 1420,
        "height": 900,
        "minWidth": 1010,
        "minHeight": 680,
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
